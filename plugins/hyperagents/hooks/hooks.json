{
  "PostToolUse": [
    {
      "matcher": "Write|Edit",
      "hooks": [
        {
          "type": "command",
          "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/track-generation.sh\"",
          "timeout": 10
        }
      ]
    }
  ],
  "Stop": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/archive-snapshot.sh\"",
          "timeout": 15
        }
      ]
    }
  ],
  "SessionStart": [
    {
      "matcher": "startup|resume",
      "hooks": [
        {
          "type": "command",
          "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/detect-evolution-state.sh\"",
          "timeout": 5
        }
      ]
    }
  ],
  "Schedule": [
    {
      "cron": "0 * * * *",
      "description": "Hourly VIVA vault recursive optimization loop — deepens insight quality, strengthens cross-domain interconnections, and integrates learnings from the HyperAgents evolutionary archive.",
      "hooks": [
        {
          "type": "command",
          "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/run-vault-optimizer.sh\"",
          "timeout": 480
        }
      ]
    }
  ]
}
